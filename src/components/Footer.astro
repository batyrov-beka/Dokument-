---
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap cols">
    <div class="about">
      <b>{SITE.name}</b>
      <p class="muted small">
        Бул сайт маалымат берүү үчүн гана. Ал мамлекеттик органдын сайты эмес. Мыйзамдар жана төлөмдөр өзгөрүп турат,
        ошондуктан барардан мурун расмий сайттан же Калкты тейлөө борборунан (КТБ/ЦОН) тактап алыңыз.
      </p>
    </div>
    <nav aria-label="Темалар">
      <b>Темалар</b>
      <ul>
        {CATEGORIES.map((c) => <li><a href={`/tema/${c.id}/`}>{c.title}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Сайт жөнүндө">
      <b>Сайт</b>
      <ul>
        <li><a href="/biz-jonundo/">Биз жөнүндө</a></li>
        <li><a href="/pin/">ПИНди чечмелөө</a></li>
        <li><a href="/izdoo/">Издөө</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap copy muted small">© {year} {SITE.name}</div>
</footer>

<style>
  .site { border-top: 1px solid var(--line); background: var(--surface); margin-top: 40px; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 28px; padding-block: 32px 20px; }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr; gap: 20px; } }
  .cols b { display: block; margin-bottom: 8px; font-family: var(--display); font-size: 0.95rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  ul a { color: var(--ink); text-decoration: none; font-size: 0.92rem; }
  ul a:hover { color: var(--accent); text-decoration: underline; }
  .about p { max-width: 52ch; }
  .copy { padding-block: 0 24px; }
</style>
