---
import Base from '../layouts/Base.astro';
import PinDecoder from '../components/PinDecoder.astro';
---
<Base title="ПИНди чечмелөө" description="Кыргызстандын 14 сандуу жеке идентификациялык номери (ПИН) эмнени билдирет? Номериңизди киргизип текшериңиз.">
  <div class="wrap page">
    <header>
      <h1>ПИН эмнени билдирет?</h1>
      <p class="lead muted">
        ПИН (жеке идентификациялык номер) – ID-картаңызда жазылган 14 сандуу номер. Ал салык, банк, Социалдык фонд жана
        башка мамлекеттик кызматтарда сиздин жеке номериңиз болуп эсептелет.
      </p>
    </header>

    <div class="grid2">
      <section class="box"><PinDecoder /></section>
      <section class="box legend">
        <h2>Номердин түзүлүшү</h2>
        <ul>
          <li><span class="sw g"></span><div><b>1-сан</b> – жынысы: 1 – аял, 2 – эркек</div></li>
          <li><span class="sw d"></span><div><b>2–9-сандар</b> – туулган күнү: күн, ай, жыл (КК АА ЖЖЖЖ)</div></li>
          <li><span class="sw n"></span><div><b>10–14-сандар</b> – каттоо номери</div></li>
        </ul>
        <p class="small muted">ПИНиңизди бөтөн адамдарга жана текшерилбеген сайттарга бербеңиз.</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .page { padding-top: 32px; display: grid; gap: 22px; }
  h1 { font-size: var(--step-3); margin-bottom: 10px; }
  .lead { max-width: 64ch; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  @media (max-width: 820px) { .grid2 { grid-template-columns: 1fr; } }
  .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 22px; min-width: 0; }
  .legend h2 { font-size: 1.05rem; margin-bottom: 12px; }
  .legend ul { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 12px; }
  .legend li { display: flex; gap: 12px; align-items: flex-start; }
  .sw { width: 18px; height: 18px; border-radius: 5px; flex: none; margin-top: 3px; border: 1px solid var(--line); }
  .sw.g { background: var(--accent); }
  .sw.d { background: var(--sun); }
  .sw.n { background: var(--surface); }
</style>
