---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { CATEGORIES, type Category } from '../../data/categories';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { slug: cat.id }, props: { cat } }));
}
interface Props { cat: Category }
const { cat } = Astro.props;
const guides = (await getCollection('guides', (g) => g.data.category === cat.id)).sort((a, b) => a.data.order - b.data.order);
---
<Base title={cat.title} description={`${cat.title}: ${cat.description}. Кадам-кадамы менен жол көрсөткүчтөр.`}>
  <div class="wrap">
    <nav class="crumbs small" aria-label="Сиз турган жер">
      <a href="/">Башкы бет</a><span aria-hidden="true">/</span><a href="/temalar/">Темалар</a>
    </nav>
    <header class="head">
      <h1>{cat.title}</h1>
      <p class="muted">{cat.description}</p>
    </header>
    <section class="section">
      {guides.length
        ? <div class="grid">{guides.map((g) => <GuideCard guide={g} showCategory={false} />)}</div>
        : <p class="muted">Бул темада жол көрсөткүчтөр жакында кошулат.</p>}
    </section>
  </div>
</Base>

<style>
  .crumbs { display: flex; gap: 8px; padding-top: 22px; color: var(--muted); }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .head { padding-top: 14px; display: grid; gap: 8px; }
  .head h1 { font-size: var(--step-3); }
</style>
