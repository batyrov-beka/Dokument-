  <circle cx="20" cy="20" r="19" fill="var(--sun)" />
  <circle cx="20" cy="20" r="9" fill="none" stroke="var(--accent)" stroke-width="2.6" />
  <path d="M13.6 13.6 26.4 26.4M26.4 13.6 13.6 26.4M17 11.6 23 28.4M23 11.6 17 28.4" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" />
</svg>
