---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import GuideCard from '../components/GuideCard.astro';
import PinDecoder from '../components/PinDecoder.astro';
import { CATEGORIES } from '../data/categories';
import { SITE } from '../data/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const popular = guides.filter((g) => g.data.popular).slice(0, 6);
const countBy = (id: string) => guides.filter((g) => g.data.category === id).length;
const quick = ['паспорт', 'прописка', 'пенсия', 'нике', 'жөлөкпул', 'права'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.href,
  inLanguage: 'ky',
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/izdoo/?q={search_term_string}', Astro.site).href,
    'query-input': 'required name=search_term_string',
  },
};
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-in">
      <h1>Документ керекпи? <em>Кантип</em> алууну кадам-кадамы менен түшүндүрөбүз.</h1>
      <p class="lead">Кайда баруу керек, кайсы кагаздарды алып баруу керек жана эмнеден баштоо керек, баары бир жерде.</p>
      <SearchBox large />
      <div class="quick">
        <span class="small muted">Көп изделгендер:</span>
        {quick.map((q) => <a class="chip" href={`/izdoo/?q=${encodeURIComponent(q)}`}>{q}</a>)}
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="cats-h">
    <div class="section-head">
      <h2 id="cats-h">Темалар</h2>
      <a href="/temalar/" class="small">Баарын көрүү →</a>
    </div>
    <div class="cats">
      {CATEGORIES.map((c) => (
        <a class="cat" href={`/tema/${c.id}/`}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d={c.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="t">{c.title}</span>
          <span class="d">{c.description}</span>
          <span class="n">{countBy(c.id)} жол көрсөткүч</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="pop-h">
    <div class="section-head"><h2 id="pop-h">Көп окулгандар</h2></div>
    <div class="grid">{popular.map((g) => <GuideCard guide={g} />)}</div>
  </section>

  <section class="section wrap" aria-labelledby="how-h">
    <div class="section-head"><h2 id="how-h">Кантип иштейт?</h2></div>
    <ol class="how">
      <li><b>Издеңиз</b><span>Керектүү документтин атын жазыңыз же тизмеден тандаңыз.</span></li>
      <li><b>Даярданыңыз</b><span>Документтердин тизмесин белгилеп, эч нерсени унутпай даярдаңыз.</span></li>
      <li><b>Барыңыз</b><span>Кадамдарды аткарып, ишиңизди бир барганда бүтүрүңүз.</span></li>
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="pin-h">
    <div class="pin-box">
      <div>
        <h2 id="pin-h">ПИНиңизде эмне жазылган?</h2>
        <p class="muted">ID-картадагы 14 сандуу жеке номер (ПИН) салык, банк жана мамлекеттик кызматтарда сурала берет. Биринчи сан жынысты, кийинки сегиз сан туулган күндү билдирет.</p>
      </div>
      <PinDecoder />
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--surface); border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  .hero::after {
    content: ''; position: absolute; right: -120px; top: -120px; width: 380px; height: 380px; border-radius: 50%;
    background: radial-gradient(circle, var(--sun-soft) 0 60%, transparent 61%);
    pointer-events: none;
  }
  .hero-in { position: relative; z-index: 1; padding-block: 56px 44px; display: grid; gap: 18px; }
  .hero h1 { font-size: var(--step-4); max-width: 19ch; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .lead { font-size: var(--step-1); color: var(--muted); max-width: 58ch; }
  .quick { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

  .cats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .cat {
    display: grid; grid-template-columns: 44px 1fr; column-gap: 14px; row-gap: 2px; align-items: start;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 18px;
    text-decoration: none; color: var(--ink); transition: border-color 0.15s;
  }
  .cat:hover { border-color: var(--accent); color: var(--ink); }
  .cat svg {
    grid-row: span 3; width: 44px; height: 44px; padding: 8px; border-radius: 12px;
    background: var(--sun-soft); color: var(--accent);
  }
  .cat .t { font-weight: 700; }
  .cat .d { color: var(--muted); font-size: 0.9rem; }
  .cat .n { color: var(--muted); font-size: 0.8rem; font-variant-numeric: tabular-nums; }

  .how { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; counter-reset: h; }
  @media (max-width: 720px) { .how { grid-template-columns: 1fr; } }
  .how li { counter-increment: h; display: grid; gap: 4px; padding: 18px; border-radius: var(--r); background: var(--surface-2); }
  .how li::before { content: counter(h); font-family: var(--display); font-size: 1.6rem; color: var(--accent); line-height: 1; margin-bottom: 6px; }
  .how span { color: var(--muted); font-size: 0.92rem; }

  .pin-box { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; background: var(--sun-soft); border-radius: var(--r); padding: 28px; }
  @media (max-width: 820px) { .pin-box { grid-template-columns: 1fr; padding: 20px; } }
  .pin-box h2 { font-size: var(--step-2); margin-bottom: 10px; }
</style>
